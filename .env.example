# 开发环境配置
# 复制为 .env 后修改值

# --- Ollama (必填) ---
OLLAMA_URL=http://localhost:11434

# --- 火山引擎方舟 (可选) ---
# API Key 格式: AccessKeyID/SecretKey
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_MODEL=doubao-code

# --- 飞书通道 (可选，启用需填写) ---
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=

# --- WebSocket (生产环境必填) ---
WEBSOCKET_AUTH_SECRET=

# --- 嵌入模型 (记忆检索用，启动时自动拉取缺失项) ---
# 可选: nomic-embed-text, embeddinggemma, nomic-embed-text-v2-moe
# EMBED_MODEL=nomic-embed-text

# --- API Gateway ---
API_GATEWAY_PORT=8000

# Memory Service
MEMORY_SERVICE_PORT=8002
MEMORY_DIR=./memory

# Cognition Service
COGNITION_SERVICE_PORT=8003

# Vision Service
VISION_SERVICE_PORT=8004

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# Multimodal Service
MULTIMODAL_SERVICE_PORT=8005

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=bayesian_agi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
